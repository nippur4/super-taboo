# Plantilla de firma para el build de release.
#
# 1. Generá tu clave (una sola vez) desde la carpeta android/:
#      keytool -genkey -v -keystore decilo-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias decilo
# 2. Copiá este archivo a "keystore.properties" (sin .example).
# 3. Completá los valores reales de abajo.
#
# keystore.properties está en .gitignore: NUNCA se sube al repo.
# Guardá el .jks y estas contraseñas en un lugar seguro: si los perdés,
# no vas a poder volver a actualizar la app en Play Store.

storeFile=decilo-upload.jks
storePassword=TU_PASSWORD_DEL_KEYSTORE
keyAlias=decilo
keyPassword=TU_PASSWORD_DE_LA_CLAVE
